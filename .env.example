# 必填：你的 API Key（OpenAI 或任意兼容服务，例如 DeepSeek）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 对话服务地址（默认 OpenAI 官方）
# OpenAI:      https://api.openai.com/v1
# DeepSeek:    https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-3.5-turbo

# 向量化后端：openai（调用接口）/ local（本地 sentence-transformers）
# 注意：DeepSeek 等只提供对话接口、没有 Embedding 接口，
#       使用这类服务时请把下面两行改为 local 并安装本地嵌入依赖：
#       pip install -r requirements-local-embeddings.txt
EMBEDDING_PROVIDER=openai
# openai 模式用：text-embedding-3-small
# local  模式用 sentence-transformers 模型名，例如：paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=text-embedding-3-small

TOP_K=3
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# 管理员知识库编辑功能（留空则关闭管理接口）
# ADMIN_TOKEN=请设置一个随机且足够长的管理员密钥
